# 服务监听配置
HOST=0.0.0.0
PORT=8787

# CORS 白名单，多个域名用逗号分隔
# 例如: https://clawmind.example.com,https://admin.example.com
CORS_ALLOWLIST=

# 是否开启访问日志（true/false）
ENABLE_ACCESS_LOG=true

# 自动备份配置
BACKUP_INTERVAL_MINUTES=360
BACKUP_RETENTION_DAYS=7

# 手动触发备份接口令牌（可选）
MANUAL_BACKUP_TOKEN=

# RAG 自动分块配置
RAG_INGEST_MAX_CHUNKS=300
RAG_INGEST_CHUNK_SIZE=1000
RAG_INGEST_CHUNK_OVERLAP=120
RAG_UPLOAD_MAX_FILE_MB=20
